CREATE TABLE pending_upload (
    id TEXT NOT NULL PRIMARY KEY,
    task_id TEXT NOT NULL,
    photo_id TEXT NOT NULL,
    file_path TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    captured_at_ms INTEGER NOT NULL,
    retry_count INTEGER NOT NULL DEFAULT 0,
    created_at_ms INTEGER NOT NULL
);

getAll:
SELECT *
FROM pending_upload
ORDER BY created_at_ms ASC;

getByTaskId:
SELECT *
FROM pending_upload
WHERE task_id = ?;

insert:
INSERT INTO pending_upload(id, task_id, photo_id, file_path, latitude, longitude, captured_at_ms, retry_count, created_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, 0, ?);

incrementRetry:
UPDATE pending_upload
SET retry_count = retry_count + 1
WHERE id = ?;

delete:
DELETE FROM pending_upload WHERE id = ?;

deleteByTaskId:
DELETE FROM pending_upload WHERE task_id = ?;

countAll:
SELECT COUNT(*) FROM pending_upload;
