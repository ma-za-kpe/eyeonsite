{
  "name": "eyeonsite-functions",
  "description": "EyeOnSite Cloud Functions v2",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:rules:storage": "jest --runTestsByPath src/storage/storageRules.test.ts --runInBand",
    "test:rules": "firebase emulators:exec --project demo-eyeonsite --config ../firebase.json --only firestore,storage \"npm run test:rules:storage\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ]
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/vision": "^5.3.6",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.0.0",
    "nodemailer": "^8.0.8",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.15",
    "firebase": "^12.13.0",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.5"
  },
  "private": true
}
