rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Waitlist: public create, admin-only read, no update/delete
    match /waitlist/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'role', 'location'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*')
        && request.resource.data.role in ['diaspora_client', 'field_agent']
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 120;
      allow read: if request.auth != null
        && request.auth.token.email == 'makpalyy@gmail.com';
      allow update, delete: if false;
    }

    // All other collections require authentication (locked down for now)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
