rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Waitlist ──────────────────────────────────────────────────────────────
    // The public landing page submits through a Cloud Function.
    // Clients never write waitlist docs directly.
    match /waitlist/{docId} {
      allow create: if false;
      allow read: if request.auth != null
        && request.auth.token.email == 'makpalyy@gmail.com';
      allow update, delete: if false;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Each user can read and write only their own profile document.
    // Cloud Functions use the Admin SDK for FCM token writes, bypassing rules.
    match /users/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    // Create: authenticated client; clientUid must match caller.
    // Read:   task owner OR matched inspector OR any pinned inspector.
    // Update: task owner may edit draft/description fields only;
    //         status transitions happen exclusively through Cloud Functions.
    // Delete: task owner, but only while still in DRAFT.
    match /tasks/{taskId} {
      allow create: if request.auth != null
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.status in ['DRAFT', 'POSTED'];

      allow read: if request.auth != null
        && (resource.data.clientUid == request.auth.uid
            || resource.data.matchedInspectorId == request.auth.uid
            || (resource.data.pinnedInspectorIds is list
                && resource.data.pinnedInspectorIds.hasAny([request.auth.uid])));

      allow update: if request.auth != null
        && resource.data.clientUid == request.auth.uid
        && resource.data.status in ['DRAFT']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['description', 'instructions', 'bountyUsd', 'locationLabel']);

      allow delete: if request.auth != null
        && resource.data.clientUid == request.auth.uid
        && resource.data.status == 'DRAFT';
    }

    // ── Inspectors ────────────────────────────────────────────────────────────
    // Authenticated users can read any inspector profile (needed for matching
    // display — name, rating, location, available flag).
    // Inspectors can update their own profile (location, available, fcmToken).
    // Status changes (available=false, activeTaskId) come from Cloud Functions.
    match /inspectors/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && (
          // Normal profile field updates (location ping, FCM token refresh, etc.)
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['location', 'fcmToken', 'name', 'city', 'photoUrl'])
          ||
          // KYC retry: inspector re-submits onboarding from a retriable state
          resource.data.onboardingStatus in ['RETRY_REQUIRED', 'EXPIRED']
        );
      allow delete: if false;
    }

    // ── Evidence ──────────────────────────────────────────────────────────────
    // The matched inspector creates intake-only documents; the server owns assessment fields.
    // The task client can read evidence for their task.
    // Status changes (qualityScore, gpsValid) come from the onEvidenceSubmitted
    // Cloud Function via the Admin SDK.
    match /evidence/{evidenceId} {
      allow create: if request.auth != null
        && request.resource.data.inspectorUid == request.auth.uid
        && request.resource.data.keys().hasAll(['taskId', 'inspectorUid', 'photos', 'submittedAtMs', 'status'])
        && request.resource.data.keys().hasOnly(['taskId', 'inspectorUid', 'photos', 'notes', 'submittedAtMs', 'status'])
        && request.resource.data.taskId is string
        && exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId))
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.matchedInspectorId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.photos is list
        && request.resource.data.photos.size() > 0
        && request.resource.data.photos.size() <= 10
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.submittedAtMs == request.time;

      allow read: if request.auth != null
        && (resource.data.inspectorUid == request.auth.uid
            || isTaskClient(resource.data.taskId, request.auth.uid));

      allow update: if request.auth != null
        && resource.data.inspectorUid == request.auth.uid
        && resource.data.status == 'DRAFT'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['photos', 'notes', 'status']);

      allow delete: if false;
    }

    // ── Escrow transactions ───────────────────────────────────────────────────
    // Written exclusively by Cloud Functions (Admin SDK bypasses these rules).
    // Clients and inspectors can read their own transaction records.
    match /escrow_transactions/{txId} {
      allow read: if request.auth != null
        && (resource.data.clientUid == request.auth.uid
            || resource.data.inspectorUid == request.auth.uid);
      allow write: if false;
    }

    // ── Escrow ledger ─────────────────────────────────────────────────────────
    // Double-entry ledger written exclusively by Cloud Functions.
    // The task client and matched inspector can read entries for their task.
    match /escrow_ledger/{entryId} {
      allow read: if request.auth != null
        && canReadTask(resource.data.taskId, request.auth.uid);
      allow write: if false;
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isTaskClient(taskId, uid) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data.clientUid == uid;
    }

    function canReadTask(taskId, uid) {
      let task = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      return task.clientUid == uid || task.matchedInspectorId == uid;
    }
  }
}
